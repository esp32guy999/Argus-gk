{
  "openapi": "3.0.3",
  "info": {
    "title": "Lidarr (curated)",
    "version": "v1"
  },
  "paths": {
    "/api/v1/system/status": {
      "get": {
        "operationId": "getSystemStatus",
        "summary": "Get Lidarr system status (version, build, OS).",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/artist": {
      "get": {
        "operationId": "listArtists",
        "summary": "List all artists in the Lidarr library.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/artist/lookup": {
      "get": {
        "operationId": "lookupArtist",
        "summary": "Search for an artist by name.",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
