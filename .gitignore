__pycache__/
*.pyc
.venv/
venv/
*.db
*.db-wal
*.db-shm
.env

# real tool manifests hold secrets/endpoints — keep only the *.example.yaml
config/n8n_tools.yaml
config/mcp_servers.yaml
config/openapi.yaml
config/shell_tools.yaml
config/navidrome.yaml
config/audiobook.yaml

# Forge service units (forge.service etc.) hold Hermes config — not tracked; we'll write our own.
# ui/server.py is now the clean, secret-free Argus server (env-based) and IS tracked.
ui/*.service
.cchome/
.ccwork/
.cc_sessions.json
.grok_sessions.json

# Paperclip uploads (materialised attachments — may contain private photos/docs)
.uploads/
# Also default cache path used by argus.attachments
# (system-wide ~/.cache/argus/uploads is outside the repo)

# Argus runtime auto-notes (not source)
notes/

# NEC data (large PDF + generated index — not for git)
data/nec/

# watcher state
scripts/.music_staging_done
scripts/.garden-last.log
evals/results/
config/lane_grants.json
config/run_code.yaml
